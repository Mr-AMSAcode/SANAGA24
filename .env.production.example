# ─────────────────────────────────────────────────────────
# Sanaga24 — production environment template
#
# Copy this file to `.env` on the VPS (never commit the real `.env`) and
# fill in every <CHANGE_ME>. See DEPLOIEMENT.md for the full walkthrough.
# ─────────────────────────────────────────────────────────

APP_NAME=Sanaga24
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Your real domain, with https:// — e.g. https://sanaga24.com
APP_URL=https://<CHANGE_ME_DOMAIN>

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# stderr → captured by `docker compose logs`, nothing lost when a
# container is recreated on redeploy.
LOG_CHANNEL=stderr
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=sanaga24
DB_USERNAME=sanaga24
# Generate with: openssl rand -base64 32
DB_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Your domain WITHOUT https:// or a leading dot — e.g. sanaga24.com
SESSION_DOMAIN=<CHANGE_ME_DOMAIN>
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL_MAILER=log means comment-reply emails are written to the log
# instead of actually sent. The site works fine without this, but
# notifications won't reach anyone until you configure real SMTP —
# see DEPLOIEMENT.md's "Email (optional but recommended)" section.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@<CHANGE_ME_DOMAIN>"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ── Reverb (self-hosted WebSocket server — no third-party real-time key) ──
REVERB_SERVER_PORT=8082
REVERB_APP_ID=<CHANGE_ME_RANDOM_ID>
REVERB_APP_KEY=<CHANGE_ME_RANDOM_KEY>
REVERB_APP_SECRET=<CHANGE_ME_RANDOM_SECRET>
# Your domain, no scheme, no port — the browser connects to wss://this/app/...
REVERB_HOST=<CHANGE_ME_DOMAIN>
REVERB_PORT=443
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
